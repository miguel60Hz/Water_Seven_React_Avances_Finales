# Configuracion de EmailJS
# Service ID ya incluido en el codigo: service_1gni7ur
#
# En emailjs.com ve a Email Templates -> crea (o abre) tu plantilla
# y copia el Template ID. La plantilla debe usar estas variables:
#   {{nombre_usuario}}, {{correo_destino}}, {{codigo_verificacion}},
#   {{tipo_mensaje}}, {{mensaje}}
#
# En Account -> Public Key copia tu clave publica.
#
# Template ID de tu plantilla de EmailJS
VITE_EMAILJS_TEMPLATE_ID=pega_aqui_tu_template_id
# Clave publica de EmailJS
VITE_EMAILJS_PUBLIC_KEY=pega_aqui_tu_public_key